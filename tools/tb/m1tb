#!/bin/bash
# ssh to the M1 Air over the Thunderbolt cable, whatever its link-local address is.
#   tools/tb/m1tb 'uname -r'            run a command as root on the M1
#   tools/tb/m1tb                       interactive shell
#   rsync -e tools/tb/m1tb m1tb:/var/log/x .    (the host argument is ignored)
#   tools/tb/m1tb --addr                print the M1's address on the link
# Needs the "m1tb" entry in ~/.ssh/config (key, user) and the key authorized on
# the M1 (tools/tb/authorize-m3-max.sh). Nothing is configured on either end:
# both sides already have IPv6 link-local addresses on thunderbolt0.
set -euo pipefail
IF=${M1TB_IF:-thunderbolt0}

[ -e "/sys/class/net/$IF" ] || { echo "m1tb: no $IF (cable out, or thunderbolt_net not loaded)" >&2; exit 2; }
own=$(ip -6 -o addr show dev "$IF" scope link | awk '{print $4}' | cut -d/ -f1)
addr=$(ping -6 -c 2 -W 1 "ff02::1%$IF" 2>/dev/null \
	| awk '/bytes from/ {a=$4; sub(/%.*/, "", a); sub(/:$/, "", a); print a}' \
	| grep -vxF "$own" | head -1 || true)
[ -n "$addr" ] || { echo "m1tb: the M1 does not answer on $IF" >&2; exit 3; }

if [ "${1:-}" = --addr ]; then echo "$addr%$IF"; exit 0; fi
[ "${1:-}" = m1tb ] && shift    # called by rsync -e / scp -S with the host first
# ssh percent-expands HostName, so the scope separator is written %%.
exec ssh -o HostName="$addr%%$IF" -o HostKeyAlias=m1tb m1tb "$@"
