pkgver() {
  cd libfprint
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd libfprint
  git reset -q --hard
  git clean -qfdx
  local p
  for p in "${_aurora_patches[@]}"; do
    echo "applying $p"
    patch -p1 --forward --no-backup-if-mismatch < "$srcdir/$p"
  done
  install -Dm644 "$srcdir/apple-sep.h" "$srcdir/aurora-uapi/linux/apple-sep.h"
}

build() {
  CFLAGS+=" -I$srcdir/aurora-uapi"
  arch-meson libfprint build -D drivers=all -D installed-tests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$srcdir/fprintd-aurora-touchid.conf" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-libfprint-aurora-touchid.conf"
}
