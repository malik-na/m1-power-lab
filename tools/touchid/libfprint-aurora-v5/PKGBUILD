# Omarchy's libfprint-git (omacom/omarchy-pkgs pkgbuilds/libfprint-git, pkgrel 5),
# rebuilt for the M1 Air's Touch ID: the kernel's apple_sep speaks /dev/sep-bio
# interface 5, and Omarchy's aurora driver accepts only 4. On aarch64 the aurora
# driver is Aurora Silicon's libfprint series instead of Omarchy's three patches:
# aurora-silicon/aurora-sep-userspace main a227a350d7ba, libfprint/ (the Fedora
# aurora13 build's Patch1000-1010 and apple-sep.h), which accepts interfaces 4
# and 5 (0005). Built on the v1.94.100 tag (80a4b5ec), the series' own base:
# Omarchy's pin (6f9479c, ten commits later, for Synaptics/FocalTech readers)
# rejects the series' tests/meson.build hunk. fprintd-aurora-touchid.conf
# is Omarchy's drop-in, unchanged.

pkgname=libfprint-git
pkgver=1.94.100.r0.g80a4b5e
pkgrel=1
epoch=2
pkgdesc="Library for fingerprint readers (Omarchy's pinned snapshot, with Aurora's Apple Touch ID driver for sep-bio v4 and v5 on aarch64)"
url="https://fprint.freedesktop.org/"
arch=(aarch64)
license=(LGPL-2.1-or-later)
depends=(gcc-libs glib2 glibc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel gobject-introspection gtk-doc meson python-cairo python-gobject systemd)
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)

_aurora_patches=(
  libfprint-1.94.100-apple-sep.patch
  0002-aurora-report-unusable-captures-as-retries.patch
  0003-hide-lid-covered-readers-while-the-lid-is-closed.patch
  0004-aurora-refuse-unbound-enrollment.patch
  0005-aurora-support-v4-and-v5.patch
  0006-aurora-report-finger-lift-and-lockout.patch
  0007-aurora-name-retry-causes-and-keep-waiting.patch
  0008-aurora-report-the-touch-id-lockout-as-locked-out.patch
  0009-aurora-say-why-touch-id-needs-the-password.patch
  0010-let-a-front-end-ask-whether-the-reader-needs-the-password.patch
  0011-aurora-name-a-touch-of-another-enrolled-finger.patch
)
source=(
  "git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=80a4b5ec612892c5c056c48dddaa561452cf37ec"
  "${_aurora_patches[@]}"
  apple-sep.h
  fprintd-aurora-touchid.conf
)
