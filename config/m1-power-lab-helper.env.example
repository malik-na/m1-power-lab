# Prepare-only example. Future deployment: root:root mode 0600 at
# /etc/m1-power-lab-helper.env. Never copy a per-device identifier into Git.
# Device must match the reviewed DeviceAllow entry in the helper unit.
M1LAB_HELPER_DEVICE=/dev/ttyACM0
M1LAB_HELPER_USB_TOPOLOGY=1-1
# UNSET deliberately fails validation. Populate from locally verified inventory.
M1LAB_HELPER_SERIAL_SHA256=UNSET
